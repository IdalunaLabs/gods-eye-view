{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/sources/*.js",
    "src/layers/*/source.js",
    "src/voice/actionSchemas.js",
    "src/voice/session.js",
    "src/data/lifecycle.js",
    "src/data/feedState.js"
  ]
}
